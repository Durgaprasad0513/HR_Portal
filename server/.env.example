DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hr_management?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/hr_management?schema=public"
PORT=5000
NODE_ENV=development
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"

# Local development storage. Production must use persistent object storage.
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads

# Only required when STORAGE_PROVIDER=r2. Keep credentials in server secrets.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Required for STORAGE_PROVIDER=s3. On Render use a dedicated scoped IAM credential.
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only set for temporary AWS credentials; they must be refreshed before expiration.
AWS_SESSION_TOKEN=

# Required when STORAGE_PROVIDER=supabase. Create a private bucket and S3 credentials
# in Supabase Storage settings. Keep these values only in server environment secrets.
SUPABASE_STORAGE_ENDPOINT=
SUPABASE_STORAGE_REGION=
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_ACCESS_KEY_ID=
SUPABASE_STORAGE_SECRET_ACCESS_KEY=
